rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function authorOrFollower(authorId) {
      return signedIn() && (authorId == request.auth.uid
        || exists(/databases/$(database)/documents/users/$(authorId)/followers/$(request.auth.uid)));
    }

    function canReadPost(postId) {
      let post = get(/databases/$(database)/documents/posts/$(postId)).data;
      return canReadPostData(post);
    }

    function canReadPostData(post) {
      return signedIn() && (post.get('surface', 'profile') == 'feed'
        || authorOrFollower(post.authorId)
        || get(/databases/$(database)/documents/users/$(post.authorId)).data.get('profilePublic', true) == true);
    }

    function notBlocked(firstUid, secondUid) {
      return !exists(/databases/$(database)/documents/users/$(firstUid)/blocked/$(secondUid))
        && !exists(/databases/$(database)/documents/users/$(secondUid)/blocked/$(firstUid));
    }

    function mutuallyFollowing(firstUid, secondUid) {
      return exists(/databases/$(database)/documents/users/$(firstUid)/following/$(secondUid))
        && exists(/databases/$(database)/documents/users/$(secondUid)/following/$(firstUid));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'pseudo', 'usernameLower', 'email', 'photo', 'bio', 'profilePublic', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.size() >= 3
        && request.resource.data.pseudo.size() <= 32
        && request.resource.data.usernameLower is string
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 300000
        && request.resource.data.get('profilePublic', true) is bool
        && request.resource.data.email == request.auth.token.email;
      allow delete: if owns(uid);

      match /following/{targetUid} {
        allow read: if signedIn();
        allow create: if owns(uid) && targetUid != uid
          && request.resource.data.uid == targetUid;
        allow delete: if owns(uid);
      }

      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create: if signedIn() && followerUid == request.auth.uid
          && request.resource.data.uid == followerUid;
        allow delete: if signedIn() && followerUid == request.auth.uid;
      }

      match /blocked/{blockedUid} {
        allow read: if owns(uid);
        allow create: if owns(uid) && uid != blockedUid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == blockedUid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if owns(uid);
      }
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['senderId', 'recipientId', 'participants', 'status', 'initialText', 'createdAt', 'updatedAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && conversationId == request.auth.uid + '_' + request.resource.data.recipientId
        && request.resource.data.participants == [request.auth.uid, request.resource.data.recipientId]
        && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientId))
        && notBlocked(request.auth.uid, request.resource.data.recipientId)
        && request.resource.data.initialText is string
        && request.resource.data.initialText.size() > 0
        && request.resource.data.initialText.size() <= 2000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.status == 'pending'
          || (request.resource.data.status == 'accepted'
            && mutuallyFollowing(request.auth.uid, request.resource.data.recipientId)));
      allow update: if signedIn()
        && request.auth.uid == resource.data.recipientId
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.updatedAt == request.time
        && notBlocked(resource.data.senderId, resource.data.recipientId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.status == 'accepted'
          && notBlocked(get(/databases/$(database)/documents/conversations/$(conversationId)).data.senderId,
                        get(/databases/$(database)/documents/conversations/$(conversationId)).data.recipientId);
        allow update, delete: if false;
      }
    }

    match /usernameReservations/{usernameKey} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower is string;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if canReadPostData(resource.data);
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000
        && request.resource.data.mediaUrl.size() <= 700000
        && request.resource.data.surface in ['feed', 'profile']
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'authorPhoto', 'text', 'mediaUrl', 'mediaType', 'mediaPath', 'surface', 'createdAt'
        ]);
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{uid} {
        allow read: if canReadPost(postId);
        allow create: if canReadPost(postId) && owns(uid) && request.resource.data.uid == request.auth.uid
          && !exists(/databases/$(database)/documents/posts/$(postId)/likes/$(uid));
        allow delete: if owns(uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if canReadPost(postId);
        allow create: if canReadPost(postId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if false;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }

      match /views/{uid} {
        allow read: if owns(uid) || (signedIn()
          && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);
        allow create: if owns(uid)
          && canReadPost(postId)
          && get(/databases/$(database)/documents/posts/$(postId)).data.authorId != request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'viewedAt'])
          && !exists(/databases/$(database)/documents/posts/$(postId)/views/$(uid));
        allow update, delete: if false;
      }
    }
  }
}
